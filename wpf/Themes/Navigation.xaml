<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sprite icons not already in Display.xaml / Overlays.xaml (24-unit box, stroke = Foreground). -->
    <Style x:Key="IconArrow" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M5,12 L19,12 M13,6 L19,12 L13,18"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Loading button spinner: 15px, 2px rgba(255,255,255,.45) ring + white top quarter.
         The rotation is driven from MainWindow.Navigation.cs (static for captures/reduced motion). -->
    <Style x:Key="ButtonSpinner" TargetType="ContentControl">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="Rotor" Width="15" Height="15">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#73FFFFFF" StrokeThickness="2" Margin="1"/>
                        <Path Data="M2.9,2.9 A6.5,6.5 0 0 1 12.1,2.9" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
