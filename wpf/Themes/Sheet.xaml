<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== Section shell ==================== -->
    <!-- .section__head p: 15px Ink2, 24px line height, max 501px. -->
    <Style x:Key="SheetSectionDesc" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="MaxWidth" Value="501"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- .demo: Surface, 1px Line, radius 16, padding 30, no shadow. -->
    <Style x:Key="DemoCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="30"/>
    </Style>

    <!-- ==================== Toolbar ==================== -->
    <!-- ghost small button: 600 13px, padding 12,7, min 32px, radius 7.
         Hover changes background/foreground only, never opacity (unlike ClaudeButtonBase). -->
    <Style x:Key="GhostButtonSm" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Ring" BorderBrush="{DynamicResource Brand}" BorderThickness="2"
                                CornerRadius="11" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SheetInfo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SheetHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="LineHeight" Value="19.2"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ==================== Frame ==================== -->
    <Style x:Key="SheetFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Plain Surface2 filler: the top-left corner and the empty cells under + column. -->
    <Style x:Key="SheetFillCell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- ==================== Header cells (.sheet__head) ==================== -->
    <!-- Column headers are left-aligned; row headers are centred via SheetRowHeadButton. -->
    <Style x:Key="SheetHeadButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SheetRowHeadButton" TargetType="Button" BasedOn="{StaticResource SheetHeadButton}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==================== Text cell (.sheet__input) ==================== -->
    <!-- Content host margin is 10px each side: WPF adds ~2px of inset, so text lands
         12px from each edge, matching the web's padding:9px 12px. -->
    <Style x:Key="SheetTextCell" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <!-- The focus ring is overlaid so it never shifts the text. -->
                            <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Brand}"
                                    CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Add controls ==================== -->
    <Style x:Key="SheetAddButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand}"/>
        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SheetAddRowButton" TargetType="Button" BasedOn="{StaticResource SheetAddButton}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ==================== Typed cells ==================== -->
    <!-- Select cell: same geometry as the text cell, with an overlaid chevron.
         The web loses the chevron on selected cells (background shorthand wipes
         background-image); replicate that with the Tag=selected trigger. -->
    <Style x:Key="SheetSelectCell" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemBd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource BrandSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Whole cell opens the list, like the web select. -->
                            <ToggleButton x:Name="DropDown"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                          Focusable="False" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Path x:Name="Chevron" Data="M4,6 L8,10 L12,6" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource Ink3}" StrokeThickness="1.33"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                  IsHitTestVisible="False"/>
                            <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Brand}"
                                    CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,2,12,12" Padding="0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Effect="{DynamicResource Shadow2}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="selected">
                            <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox cell: 16x16, radius 2.5; imitates Chromium accent-color: SheetCheckFill + SheetCheckBorder when off, Brand + SheetCheckMark tick when on (dark: #3B3B3B fill, #858585 border, #3B3B3B tick, measured). -->
    <Style x:Key="SheetCheckboxCell" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <!-- Fill is visual only; padding clicks must not toggle the box. -->
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"/>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="2.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource SheetCheckFill}" BorderBrush="{DynamicResource SheetCheckBorder}" BorderThickness="1">
                            <Path x:Name="Tick" Data="M3.5,8 L6.5,11 L12.5,4" Width="16" Height="16" Stretch="None"
                                  Stroke="{DynamicResource SheetCheckMark}" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"
                                  IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="selected">
                            <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brand}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
