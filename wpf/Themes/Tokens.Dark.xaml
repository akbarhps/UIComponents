<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark overlay: same SolidColorBrush / DropShadowEffect keys as Tokens.xaml, dark values from the :root
         light-dark() tokens in web/index.html. ThemeManager merges this as the LAST dictionary of
         Application.Resources, so it overrides Tokens.xaml. Brushes and effects only (no fonts or radii). -->
    <SolidColorBrush x:Key="Bg" Color="#FF1C1A17"/>
    <SolidColorBrush x:Key="BgDeep" Color="#FF161412"/>
    <SolidColorBrush x:Key="Surface" Color="#FF24221E"/>
    <SolidColorBrush x:Key="Surface2" Color="#FF2A2723"/>
    <SolidColorBrush x:Key="Ink" Color="#FFECE8DF"/>
    <SolidColorBrush x:Key="Ink2" Color="#FFB8B0A2"/>
    <SolidColorBrush x:Key="Ink3" Color="#FF9A9284"/>
    <SolidColorBrush x:Key="Line" Color="#FF34302A"/>
    <SolidColorBrush x:Key="LineStrong" Color="#FF5A5449"/>
    <SolidColorBrush x:Key="Brand" Color="#FFE08A66"/>
    <SolidColorBrush x:Key="BrandHover" Color="#FFEA9C7B"/>
    <SolidColorBrush x:Key="BrandBright" Color="#FFD97757"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#FF3A2820"/>
    <SolidColorBrush x:Key="BrandSoftHover" Color="#FF47302A"/>
    <SolidColorBrush x:Key="Success" Color="#FF7CC39A"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#FF1E2E25"/>
    <SolidColorBrush x:Key="Warning" Color="#FFD9A952"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#FF2F2616"/>
    <SolidColorBrush x:Key="Danger" Color="#FFEC8A80"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FF3A201D"/>
    <SolidColorBrush x:Key="Info" Color="#FF8FB4D6"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#FF1D2733"/>
    <SolidColorBrush x:Key="Focus" Color="#FFE08A66"/>
    <SolidColorBrush x:Key="OnBrand" Color="#FF1C1A17"/>
    <SolidColorBrush x:Key="OnInk" Color="#FF1C1A17"/>
    <SolidColorBrush x:Key="InkHover" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FF1C1A17"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFF29D94"/>
    <SolidColorBrush x:Key="BrandLine" Color="#FF5A3A2C"/>
    <SolidColorBrush x:Key="SuccessLine" Color="#FF2D4636"/>
    <SolidColorBrush x:Key="InfoLine" Color="#FF2E3F52"/>
    <SolidColorBrush x:Key="DangerLine" Color="#FF5A2F2A"/>
    <SolidColorBrush x:Key="SageSoft" Color="#FF24302A"/>
    <SolidColorBrush x:Key="SageLine" Color="#FF33463A"/>
    <SolidColorBrush x:Key="Wash" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="WashStrong" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
    <SolidColorBrush x:Key="Shimmer" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="FocusRing" Color="#59E08A66"/>
    <SolidColorBrush x:Key="Knob" Color="#FFF3EFE7"/>
    <SolidColorBrush x:Key="SheetCheckBorder" Color="#FF858585"/>
    <SolidColorBrush x:Key="SheetCheckMark" Color="#FF3B3B3B"/>
    <SolidColorBrush x:Key="SheetCheckFill" Color="#FF3B3B3B"/>

    <DropShadowEffect x:Key="Shadow1" Color="#FF000000" Opacity="0.4" BlurRadius="14" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="Shadow2" Color="#FF000000" Opacity="0.55" BlurRadius="30" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="KnobShadow" Color="#FF000000" Opacity="0.5" BlurRadius="3" ShadowDepth="1" Direction="270"/>
</ResourceDictionary>
