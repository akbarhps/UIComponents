<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Searchable select trigger ==================== -->
    <!-- 46 high, 1px LineStrong, radius 8. Open: Brand border + 3px BrandSoft ring.
         Keyboard focus while closed uses the web's 2px Brand outline. -->
    <Style x:Key="DropdownTrigger" TargetType="ToggleButton">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="OpenRing" BorderThickness="3" BorderBrush="{DynamicResource FocusRing}"
                                CornerRadius="11" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Brand}"
                                CornerRadius="12" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                <Viewbox x:Name="Chevron" Width="16" Height="16" HorizontalAlignment="Right"
                                         VerticalAlignment="Center">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform Angle="0" CenterX="8" CenterY="8"/>
                                    </Viewbox.RenderTransform>
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource Ink3}" StrokeThickness="2"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                            <Setter TargetName="OpenRing" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="8" CenterY="8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Panel ==================== -->
    <!-- Shadow2 lives on a sibling background Border: an Effect on the content greyscales text. -->
    <Style x:Key="DropdownPanelShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow2}"/>
    </Style>
    <Style x:Key="DropdownPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- ==================== Search field ==================== -->
    <ControlTemplate x:Key="DropdownSearchTemplate" TargetType="TextBox">
        <Grid>
            <Border x:Name="FocusRing" BorderThickness="3" BorderBrush="{DynamicResource FocusRing}"
                    CornerRadius="10" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                <Grid>
                    <ScrollViewer x:Name="PART_ContentHost" Margin="29,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="31,0,0,0"
                               VerticalAlignment="Center" FontFamily="{StaticResource Sans}" FontSize="13"
                               LineHeight="18.2" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Ink3}" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="DropdownSearch" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="36.2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource DropdownSearchTemplate}"/>
    </Style>

    <!-- Keyed only: applied through the list ScrollViewer's Resources[typeof(ScrollBar)]. -->
    <Style x:Key="DropdownScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="11" Background="{DynamicResource LineStrong}"
                                                BorderBrush="{DynamicResource Bg}" BorderThickness="3"
                                                CornerRadius="5.5" Margin="0,1"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Option row / empty row ==================== -->
    <Style x:Key="DropdownOption" TargetType="Button">
        <Setter Property="Height" Value="40.4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,9">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropdownEmpty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20.8"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,18"/>
    </Style>

    <!-- i-check: M5,12 L10,17 L19,7 in a 24 box, stroke 2.4, scaled to 14. -->
    <Style x:Key="DropdownCheck" TargetType="ContentControl">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5,12 L10,17 L19,7" Stroke="{DynamicResource Brand}" StrokeThickness="2.4"
                                  Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Multi-select ==================== -->
    <!-- Chrome only; the chip/chevron grid is built in code so the chevron can move between
         its empty (centred) and with-chips (top) positions. -->
    <Style x:Key="MultiTriggerChrome" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="OpenRing" BorderThickness="3" BorderBrush="{DynamicResource FocusRing}"
                                CornerRadius="11" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Brand}"
                                CornerRadius="12" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                            <Setter TargetName="OpenRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MultiPlaceholder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="19.6"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 24.8 high: 16.8 line + 8 padding. -->
    <Style x:Key="MultiChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChipRemove" TargetType="Button">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Brand}"
                                  StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-row hover; the checkbox box, label and meta are built in code. -->
    <Style x:Key="MultiOption" TargetType="CheckBox">
        <Setter Property="Height" Value="40.4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Brand}"
                                CornerRadius="9" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MultiFoot" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Height" Value="53"/>
    </Style>

    <!-- ==================== Tag input / autocomplete text field ==================== -->
    <Style x:Key="TagBox" TargetType="Border">
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ink3}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brand}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="BareInputTemplate" TargetType="TextBox">
        <Grid>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="2,0,0,0"
                       VerticalAlignment="Center" FontFamily="{StaticResource Sans}" FontSize="14"
                       Foreground="{DynamicResource Ink3}" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="BareInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource BareInputTemplate}"/>
    </Style>

    <!-- Autocomplete: 37-high text rows, 52.8-high empty row. -->
    <Style x:Key="AcOption" TargetType="Button" BasedOn="{StaticResource DropdownOption}">
        <Setter Property="Height" Value="37"/>
    </Style>
    <Style x:Key="AcEmpty" TargetType="TextBlock" BasedOn="{StaticResource DropdownEmpty}">
        <Setter Property="Padding" Value="10,16"/>
    </Style>

</ResourceDictionary>
