<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chrome-free GroupBox so the adorner-hosted panel has a UIA peer and a Name. -->
    <Style x:Key="PickerPanelRoot" TargetType="GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 46 high, 1px LineStrong, radius 8. Icon at +14, value at +39 (B1). -->
    <Style x:Key="PickerTrigger" TargetType="ToggleButton">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="OpenRing" BorderThickness="3" BorderBrush="{StaticResource BrandSoft}"
                                CornerRadius="11" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{StaticResource Brand}"
                                CornerRadius="12" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand}"/>
                            <Setter TargetName="OpenRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PickerDow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="LineHeight" Value="17.6"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 32 high, radius 7. Tag is non-null only for the selected cell, so hover never
         overrides the Brand fill (same cascade as the web's :hover/.selected rules). -->
    <Style x:Key="PickerCell" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{StaticResource Brand}"
                                CornerRadius="9" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgDeep}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- File drop: 1px dashed 3/2 border behind the content (a Border cannot dash). -->
    <Style x:Key="PickerFileDrop" TargetType="Button">
        <Setter Property="Height" Value="135.6"/>
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Padding" Value="26,20"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" BorderThickness="3" BorderBrush="{StaticResource BrandSoft}"
                                CornerRadius="15" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Grid>
                                <Rectangle x:Name="Dash" Stroke="{StaticResource LineStrong}" StrokeThickness="1"
                                           StrokeDashArray="3 2" RadiusX="12" RadiusY="12"
                                           SnapsToDevicePixels="True" Margin="0.5" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brand}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="dragover">
                            <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brand}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource Brand}"/>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerFileItem" TargetType="Border">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>
</ResourceDictionary>
