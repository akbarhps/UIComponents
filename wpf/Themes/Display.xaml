<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UIComponents.Wpf">

    <!-- .card: Surface, 1px Line, radius 12, padding 22, no shadow. -->
    <Style x:Key="DisplayCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- Web .card__title 17px/1.3 (22.1px) and .card__text 14px/1.6 (22.4px).
         Palatino's natural line box exceeds 22.1, so the title uses BlockLineHeight;
         Segoe's does not, so the text uses MaxHeight. -->
    <Style x:Key="DisplayCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="LineHeight" Value="22.1"/>
        <!-- Palatino's natural line box is ~22.94 (>22.1); MaxHeight grows the box and
             pushes everything below down 0.84. BlockLineHeight keeps the 22.1 layout. -->
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="DisplayCardText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="LineHeight" Value="22.4"/>
        <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Small button (web .btn sm): 600 13px, padding 12,7, min 32px, radius 7.
         Hover changes colour, never opacity (unlike ClaudeButtonBase). -->
    <Style x:Key="SecondaryButtonSm" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- 12,7,12,5 keeps the 13px text ink at +8.4 while MinHeight stays 32. -->
        <Setter Property="Padding" Value="12,7,12,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Ring" BorderBrush="{DynamicResource Brand}" BorderThickness="2"
                                CornerRadius="11" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="No"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonSm" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnBrand}"/>
        <Setter Property="Background" Value="{DynamicResource Brand}"/>
        <!-- No border: CSS paints the background under the 1px transparent border, so
             the Brand fill must span the full 106.3x32. 13,8,13,6 keeps the text ink
             at +8.4 while MinHeight stays 32. -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="13,8,13,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow1}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Ring" BorderBrush="{DynamicResource Brand}" BorderThickness="2"
                                CornerRadius="11" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Effect" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="No"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .badge: 12px 600, 24 tall, radius 99, padding 6px 10px, 6px dot + 6px gap.
         Tag="Plain" collapses the dot (web plain badge before pseudo-element). -->
    <Style x:Key="DisplayBadge" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Height="24" CornerRadius="12" Padding="10,0"
                            Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Foreground}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Plain">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BadgeNeutralDot" TargetType="ContentControl" BasedOn="{StaticResource DisplayBadge}">
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
    </Style>
    <Style x:Key="BadgeBrandDot" TargetType="ContentControl" BasedOn="{StaticResource DisplayBadge}">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand}"/>
    </Style>
    <Style x:Key="BadgeSuccessDot" TargetType="ContentControl" BasedOn="{StaticResource DisplayBadge}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
    </Style>
    <Style x:Key="BadgeWarningDot" TargetType="ContentControl" BasedOn="{StaticResource DisplayBadge}">
        <Setter Property="Background" Value="{DynamicResource WarningSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
    </Style>
    <Style x:Key="BadgeDangerDot" TargetType="ContentControl" BasedOn="{StaticResource DisplayBadge}">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>

    <!-- ==================== Alerts ==================== -->
    <Style x:Key="Alert" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,15"/>
    </Style>
    <Style x:Key="AlertTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="22.4"/>
        <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
    </Style>
    <Style x:Key="AlertText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <!-- CSS half-leading (22.4 - 1.33*14)/2 = 1.9px above and below the natural
             18.62px line box: same 22.4px box, ink centred like Chromium.
             Margin top = web 2px gap + 1.9px half-leading. -->
        <Setter Property="Margin" Value="0,3.9,0,1.9"/>
    </Style>

    <!-- Sprite icons: 24x24 viewBox, stroke = Foreground of the instance. -->
    <Style x:Key="IconInfo" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 M12,11 L12,16 M12,8 L12,8.5"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconCheck" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M5,12 L10,17 L19,7"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconAlert" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M12,3 L2,20 L22,20 Z M12,9 L12,14 M12,17.5 L12,18"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconClose" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6,6 L18,18 M18,6 L6,18"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconCard" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,4 L19,4 A2,2 0 0,1 21,6 L21,18 A2,2 0 0,1 19,20 L5,20 A2,2 0 0,1 3,18 L3,6 A2,2 0 0,1 5,4 Z M3,9 L21,9"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconSearch" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M18,11 A7,7 0 1,1 4,11 A7,7 0 1,1 18,11 M20,20 L16.5,16.5"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Empty state ==================== -->
    <Style x:Key="EmptyTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EmptyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="LineHeight" Value="22.4"/>
        <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="317"/>
    </Style>

    <!-- ==================== Avatars ==================== -->
    <!-- Size, radius and tones are set on each instance; 40x40 brand is the default. -->
    <Style x:Key="AvatarCircle" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="AvatarInitials" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand}"/>
        <!-- No LineHeight: the natural line box centres the glyph like CSS place-items. -->
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================== Skeleton ==================== -->
    <Style x:Key="SkLine" TargetType="Border">
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="local:Shimmer.Enabled" Value="True"/>
    </Style>
    <Style x:Key="SkCircle" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource BgDeep}"/>
        <Setter Property="local:Shimmer.Enabled" Value="True"/>
    </Style>
    <Style x:Key="MotionCue" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}"/>
        <Setter Property="CornerRadius" Value="99"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- ==================== Progress ==================== -->
    <Style x:Key="DisplayProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{DynamicResource BgDeep}" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Border x:Name="PART_Indicator" Background="{DynamicResource Brand}" CornerRadius="4"
                                HorizontalAlignment="Left" Width="0" SnapsToDevicePixels="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
