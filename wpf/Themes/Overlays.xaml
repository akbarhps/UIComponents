<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Modal card ==================== -->
    <!-- Shadow on a sibling background Border: an Effect on the content rasterises the text. -->
    <Style x:Key="ModalCardShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow2}"/>
    </Style>
    <Style x:Key="ModalCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="26"/>
    </Style>
    <Style x:Key="ModalTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="LineHeight" Value="26.25"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="ModalBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        <Setter Property="LineHeight" Value="22.4"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ==================== Dialog form fields ==================== -->
    <Style x:Key="FormErrorRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,7,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="FormErrorText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="LineHeight" Value="19.2"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ==================== Command palette ==================== -->
    <Style x:Key="CmdkInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="1,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"/>
                            <!-- Tag holds the placeholder, as in FieldInputTemplate. -->
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource Sans}" FontSize="16"
                                       Foreground="{DynamicResource Ink3}" Visibility="Collapsed"
                                       IsHitTestVisible="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CmdkGroup" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="Height" Value="29.6"/>
        <Setter Property="Padding" Value="10,8,10,4"/>
    </Style>
    <Style x:Key="CmdkItem" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="11,10"/>
        <Setter Property="MinHeight" Value="39"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CmdkChip" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

    <!-- ==================== Icon buttons ==================== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" Margin="-4" CornerRadius="11" BorderThickness="2"
                                BorderBrush="Transparent" Visibility="Collapsed"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDeep}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButtonSm" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
    </Style>

    <!-- ==================== Sprite icons (24-unit box, stroke = Foreground) ==================== -->
    <!-- Only icons not already in Display.xaml live here: IconClose/IconCheck/IconInfo/
         IconAlert/IconSearch are reused from Display. -->
    <Style x:Key="IconPlus" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,5 L12,19 M5,12 L19,12"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconMore" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,12 A1,1 0 1,1 6,12 A1,1 0 1,1 4,12 M11,12 A1,1 0 1,1 13,12 A1,1 0 1,1 11,12 M18,12 A1,1 0 1,1 20,12 A1,1 0 1,1 18,12"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconDownload" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12,4 L12,16 M12,16 L17,11 M12,16 L7,11 M4,17 L4,19 A2,2 0 0,0 6,21 L18,21 A2,2 0 0,0 20,19 L20,17"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButtonGlyph" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6,7 L18,7 A3,3 0 0,1 21,10 L21,14 A3,3 0 0,1 18,17 L6,17 A3,3 0 0,1 3,14 L3,10 A3,3 0 0,1 6,7 Z M9.5,12 L14.5,12"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconTable" TargetType="ContentControl">
        <Setter Property="Template">
