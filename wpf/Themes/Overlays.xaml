                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Data="M5,4 L19,4 A2,2 0 0,1 21,6 L21,18 A2,2 0 0,1 19,20 L5,20 A2,2 0 0,1 3,18 L3,6 A2,2 0 0,1 5,4 Z M3,9 L21,9 M3,14 L21,14 M9,9 L9,20"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
