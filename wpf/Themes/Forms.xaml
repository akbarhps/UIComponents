<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Field input (.input) ==================== -->
    <!-- Shared by FieldInput, FieldInputError and FieldInputSearch. The border brush is
         template-bound so each style controls idle/hover/focus colours on its own. -->
    <ControlTemplate x:Key="FieldInputTemplate" TargetType="TextBox">
        <Grid>
            <!-- 3px BrandSoft ring outside the 1px border; margin -3 keeps it out of layout. -->
            <Border x:Name="FocusRing" BorderThickness="3" BorderBrush="{StaticResource BrandSoft}"
                    CornerRadius="11" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="Bd" Background="{StaticResource Surface}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"/>
                    <!-- Tag holds the placeholder. It stays visible on focus, like the web. -->
                    <Border Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                   FontFamily="{StaticResource Sans}" FontSize="15"
                                   LineHeight="21" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource Ink3}" Margin="2,0,0,0"
                                   Visibility="Collapsed"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,0,11,0"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource FieldInputTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Ink3}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Search: text/placeholder start 39px from the outer edge. The icon is overlaid in
         MainWindow so it never shifts the text; only the padding changes here. -->
    <Style x:Key="FieldInputSearch" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
        <Setter Property="Padding" Value="36,0,11,0"/>
    </Style>

    <!-- .field.has-error .input: Danger in every state; focus still shows the BrandSoft ring.
         Standalone style (not BasedOn) so the normal hover/focus colour triggers are absent. -->
    <Style x:Key="FieldInputError" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,0,11,0"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource FieldInputTemplate}"/>
    </Style>

    <!-- ==================== Icons ==================== -->
    <!-- 16px search glyph (i-search): circle cx11 cy11 r7 + handle, scaled from a 24 box. -->
    <Style x:Key="SearchIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="4" Canvas.Top="4" Width="14" Height="14"
                                     Stroke="{StaticResource Ink3}" StrokeThickness="1.9"/>
                            <Path Data="M20,20 L16.5,16.5" Stroke="{StaticResource Ink3}"
                                  StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 13px alert glyph (i-alert), scaled from a 24 box. -->
    <Style x:Key="ErrorIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,3 L2,20 L22,20 Z" Stroke="{StaticResource Danger}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M12,9 L12,14 M12,17.5 L12,18" Stroke="{StaticResource Danger}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .divider: 1px Line with 26px above and below. -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Margin" Value="0,26,0,26"/>
    </Style>

</ResourceDictionary>
