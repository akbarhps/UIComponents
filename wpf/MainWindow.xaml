                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="37" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="297.8*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="157.7*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="105.1*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="188.6*"/>
                                                <ColumnDefinition Width="78.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="2" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="36" Padding="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210.2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="192.7*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="131.4*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="197.3*"/>
                                                <ColumnDefinition Width="96.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="2" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Form inputs -->
                <local:InputControls x:Name="FormInputs"/>

                <!-- Pickers -->
                <local:PickerControls x:Name="Pickers"/>

                <!-- Data controls -->
                <local:DataControls x:Name="DataTables"/>

                <!-- Advanced controls -->
                <local:AdvancedControls x:Name="AdvancedTables"/>

                <!-- Toast demos -->
                <local:ToastControls x:Name="ToastDemos"/>

                <!-- Overlay demos -->
                <local:OverlayControls x:Name="Overlays"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
