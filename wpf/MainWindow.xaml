                                <Button Content="Start upload" Style="{StaticResource PrimaryButton}"
                                        Click="ProgressStart_Click" AutomationProperties.AutomationId="ProgressStart"/>
                                <Button Content="Reset" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                        Click="ProgressReset_Click" AutomationProperties.AutomationId="ProgressReset"/>
                            </StackPanel>
