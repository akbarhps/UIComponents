                                                <GroupBox.Template>
                                                    <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                                </GroupBox.Template>
                                                <ContentControl Style="{StaticResource IconCheck}" Width="15" Height="15" Foreground="White"/>
                                            </GroupBox>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="0,39,16,0">
                                        <TextBlock x:Name="Step1_Title" Text="Workspace" Style="{StaticResource StepTitle}"
                                                   Foreground="{StaticResource Ink3}"/>
