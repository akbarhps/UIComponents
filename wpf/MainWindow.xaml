                           Text="Switch between related views without leaving the page."/>
                <GroupBox AutomationProperties.AutomationId="TabsCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Height="41" AutomationProperties.AutomationId="Tabs">
                                <RadioButton x:Name="TabProfile" Content="Profile" Style="{StaticResource TabButton}"
                                             IsChecked="True" Checked="Tab_Checked" KeyDown="Tab_KeyDown"
                                             AutomationProperties.AutomationId="TabProfile"/>
                                <RadioButton x:Name="TabSecurity" Content="Security" Style="{StaticResource TabButton}"
                                             IsTabStop="False" Margin="4,0,0,0" Checked="Tab_Checked" KeyDown="Tab_KeyDown"
                                             AutomationProperties.AutomationId="TabSecurity"/>
                                <RadioButton x:Name="TabBilling" Content="Billing" Style="{StaticResource TabButton}"
                                             IsTabStop="False" Margin="4,0,0,0" Checked="Tab_Checked" KeyDown="Tab_KeyDown"
                                             AutomationProperties.AutomationId="TabBilling"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,-1,0,0"/>
                            <TextBlock x:Name="TabPanel" Style="{StaticResource TabPanelText}" Margin="0,18,0,0"
                                       Text="Update your name, photo and public profile details."
