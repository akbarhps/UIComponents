<Window x:Class="UIComponents.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UIComponents.Wpf"
        Title="Claude UI — WPF components" Height="820" Width="1180"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Sans}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="28,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,26">
                    <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource BrandBright}" Margin="0,0,11,0"/>
                    <StackPanel>
                        <TextBlock Text="Claude UI" FontFamily="{StaticResource Serif}" FontSize="18" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Component library" FontSize="11" Foreground="{StaticResource Ink3}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                    <TextBlock Text="Basics" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}" Margin="0,0,0,8"/>
                    <TextBlock Text="Buttons" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Cards" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Badges" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Forms" Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
                    <TextBlock Text="Fields" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Data" Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
                    <TextBlock Text="Table" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="48,56,48,96">
            <StackPanel x:Name="Sections" MaxWidth="984">
                <!-- Masthead -->
                <Border Background="{StaticResource BrandSoft}" CornerRadius="99" Padding="11,5" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <TextBlock Text="Web components, version 1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brand}"/>
                </Border>
                <TextBlock Text="Interface components" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="{StaticResource Ink}" TextWrapping="Wrap" MaxWidth="640"/>
                <TextBlock Text="A native WPF component library with the same warm, editorial feel as the web version. Every colour and font comes from a shared token dictionary." Style="{StaticResource SectionDesc}" MaxWidth="640" Margin="0,12,0,0"/>

                <!-- Buttons -->
                <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Primary, dark, secondary, ghost and danger variants, with size options and loading / disabled states."/>
                <GroupBox AutomationProperties.AutomationId="ButtonsCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <TextBlock Text="Variants" Style="{StaticResource DemoLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Primary action" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,12,0" AutomationProperties.AutomationId="BtnPrimary"/>
                                <Button Content="Dark" Style="{StaticResource DarkButton}"
                                        Margin="0,0,12,0" AutomationProperties.AutomationId="BtnDark"/>
                                <Button Content="Secondary" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,12,0" AutomationProperties.AutomationId="BtnSecondary"/>
                                <Button Content="Ghost" Style="{StaticResource GhostButton}"
                                        Margin="0,0,12,0" AutomationProperties.AutomationId="BtnGhost"/>
                                <Button Content="Danger" Style="{StaticResource DangerButton}"
                                        AutomationProperties.AutomationId="BtnDanger"/>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="With icons" Style="{StaticResource DemoLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                        AutomationProperties.AutomationId="BtnNewItem" AutomationProperties.Name="New item">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource IconPlus}" Width="16" Height="16"/>
                                        <TextBlock Text="New item" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                                        AutomationProperties.AutomationId="BtnSearch" AutomationProperties.Name="Search">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource IconSearch}" Width="16" Height="16"/>
                                        <TextBlock Text="Search" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        AutomationProperties.AutomationId="BtnContinue" AutomationProperties.Name="Continue">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Continue"/>
                                        <ContentControl Style="{StaticResource IconArrow}" Width="16" Height="16" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Sizes &amp; states" Style="{StaticResource DemoLabel}"/>
                            <StackPanel Orientation="Horizontal" Height="50">
                                <Button Content="Small" Style="{StaticResource PrimaryButtonSm}"
                                        VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="BtnSmall"/>
                                <!-- Segoe's "Default" advance is 3.5 short of the web's SF advance. -->
                                <Button Content="Default" Style="{StaticResource PrimaryButton}" MinWidth="82.5"
                                        VerticalAlignment="Center" Margin="0,0,12,0"
                                        AutomationProperties.AutomationId="BtnDefault"/>
                                <Button Content="Large" Style="{StaticResource PrimaryButton}" FontSize="15"
                                        Padding="23,15" MinHeight="50" VerticalAlignment="Center" Margin="0,0,12,0"
                                        AutomationProperties.AutomationId="BtnLarge"/>
                                <Button Content="Disabled" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                        VerticalAlignment="Center" Margin="0,0,12,0"
                                        AutomationProperties.AutomationId="BtnDisabled"/>
                                <Button x:Name="BtnLoading" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" Click="BtnLoading_Click"
                                        AutomationProperties.AutomationId="BtnLoading" AutomationProperties.Name="Loading">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl x:Name="BtnLoadingSpinner" Style="{StaticResource ButtonSpinner}" Width="15" Height="15"
                                                        Loaded="LoadingSpinner_Loaded"/>
                                        <TextBlock Text="Loading" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Action menu -->
                <TextBlock Text="Action menu" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="A popover of actions anchored to a button. Navigate with the arrow keys, activate with Enter, and close with Escape or an outside click."/>
                <GroupBox AutomationProperties.AutomationId="MenuCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Height="42">
                                <Button x:Name="MenuActions" Style="{StaticResource SecondaryButton}"
                                        Click="MenuActions_Click" KeyDown="MenuTrigger_KeyDown"
                                        AutomationProperties.AutomationId="MenuActions">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Actions"/>
                                        <ContentControl x:Name="MenuChevron" Style="{StaticResource IconChevron}"
                                                        Width="16" Height="16" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuMore" Style="{StaticResource IconButton}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Click="MenuMore_Click"
                                        KeyDown="MenuTrigger_KeyDown"
                                        AutomationProperties.AutomationId="MenuMore" AutomationProperties.Name="More actions">
                                    <ContentControl Style="{StaticResource IconMore}" Width="18" Height="18"/>
                                </Button>
                                <TextBlock x:Name="MenuResult" Style="{StaticResource FieldHint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Text="Choose an action…"
                                           AutomationProperties.AutomationId="MenuResult"/>
                            </StackPanel>

                            <!-- Panels are moved to PopoverLayer on first open. -->
                            <GroupBox x:Name="ProjectMenuPanel" Style="{StaticResource MenuPanel}" Visibility="Collapsed"
                                      KeyDown="MenuPanel_KeyDown"
                                      AutomationProperties.AutomationId="ProjectMenu" AutomationProperties.Name="Actions">
                                <StackPanel Width="196">
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Edit project"
                                            AutomationProperties.AutomationId="ProjectMenu_Item0" AutomationProperties.Name="Edit project">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconEdit}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Edit project" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="Ctrl E" Style="{StaticResource MenuShortcut}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Duplicate"
                                            AutomationProperties.AutomationId="ProjectMenu_Item1" AutomationProperties.Name="Duplicate">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconCopy}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Duplicate" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="Ctrl D" Style="{StaticResource MenuShortcut}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Export as CSV"
                                            AutomationProperties.AutomationId="ProjectMenu_Item2" AutomationProperties.Name="Export as CSV">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconDownload}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Export as CSV" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Border Style="{StaticResource MenuDivider}"/>
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Pin to top"
                                            AutomationProperties.AutomationId="ProjectMenu_Item3" AutomationProperties.Name="Pin to top">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconPin}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Pin to top" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuItem}" IsEnabled="False" IsTabStop="False"
                                            AutomationProperties.AutomationId="ProjectMenu_Item4" AutomationProperties.Name="Archive">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconInfo}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Archive" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Border Style="{StaticResource MenuDivider}"/>
                                    <Button Style="{StaticResource MenuItemDanger}" Click="MenuItem_Click" Tag="Delete project"
                                            AutomationProperties.AutomationId="ProjectMenu_Item5" AutomationProperties.Name="Delete project">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconTrash}" Width="16" Height="16"/>
                                            <TextBlock Grid.Column="1" Text="Delete project" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="CompactMenuPanel" Style="{StaticResource MenuPanel}" Height="136"
                                      Visibility="Collapsed" KeyDown="MenuPanel_KeyDown"
                                      AutomationProperties.AutomationId="CompactMenu"
                                      AutomationProperties.Name="More actions">
                                <StackPanel Width="196">
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Rename"
                                            AutomationProperties.AutomationId="CompactMenu_Item0" AutomationProperties.Name="Rename">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconEdit}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Rename" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource MenuItem}" Click="MenuItem_Click" Tag="Make a copy"
                                            AutomationProperties.AutomationId="CompactMenu_Item1" AutomationProperties.Name="Make a copy">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconCopy}" Width="16" Height="16" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Grid.Column="1" Text="Make a copy" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Border Style="{StaticResource MenuDivider}"/>
                                    <Button Style="{StaticResource MenuItemDanger}" Click="MenuItem_Click" Tag="Remove"
                                            AutomationProperties.AutomationId="CompactMenu_Item2" AutomationProperties.Name="Remove">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ContentControl Style="{StaticResource IconTrash}" Width="16" Height="16"/>
                                            <TextBlock Grid.Column="1" Text="Remove" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Forms -->
                <TextBlock Text="Forms" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Labels, hints, validation, select, textarea and selection controls. All fields share the same focus and error language."/>
                <!-- GroupBox gives the card a UIA peer: a plain Border has none, so the
                     hidden capture runner cannot find an AutomationId on it. No chrome. -->
                <GroupBox AutomationProperties.AutomationId="FormsCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                    <StackPanel>
                        <!-- .grid-2 #1: equal 450px columns, 22px gap. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldInput}" Tag="Ada Lovelace"
                                         AutomationProperties.AutomationId="FieldName"/>
                                <TextBlock Text="As it should appear on your account." Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldInput}" Tag="you@example.com"
                                         AutomationProperties.AutomationId="FieldEmail"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <!-- .grid-2 #2: Search (icon overlay) | Role (Phase 2). -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <TextBox Style="{StaticResource FieldInputSearch}" Tag="Find something…"
                                             AutomationProperties.AutomationId="FieldSearch"/>
                                    <ContentControl Style="{StaticResource SearchIcon}" Margin="13,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FieldSelect}" SelectedIndex="0"
                                          AutomationProperties.AutomationId="CmbRole">
                                    <ComboBoxItem Content="Designer"/>
                                    <ComboBoxItem Content="Engineer"/>
                                    <ComboBoxItem Content="Product manager"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <!-- Full width: Message textarea + hint. -->
                        <StackPanel>
                            <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <TextBox x:Name="MessageText" Style="{StaticResource FieldTextArea}"
                                         Tag="Write a short note…" AutomationProperties.AutomationId="FieldMessage"/>
                                <Thumb Style="{StaticResource TextAreaGrip}" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Margin="0,0,2,2"
                                       DragDelta="MessageGrip_DragDelta"/>
                            </Grid>
                            <TextBlock Text="Keep it under a few sentences." Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}"/>

                        <!-- Full width: Username, error state. "ada#" is a real value. -->
                        <StackPanel>
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource FieldInputError}" Text="ada#"
                                     AutomationProperties.AutomationId="FieldUsername"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <ContentControl Style="{StaticResource ErrorIcon}" Margin="0,3,5,0"
                                                VerticalAlignment="Top"/>
                                <TextBlock Text="Use letters and numbers only." FontFamily="{StaticResource Sans}"
                                           FontSize="12" Foreground="{StaticResource Danger}"
                                           LineHeight="19.2" LineStackingStrategy="BlockLineHeight"
                                           VerticalAlignment="Top"
                                           AutomationProperties.AutomationId="FieldUsernameError"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Card 2: selection controls -->
                <GroupBox AutomationProperties.AutomationId="SelectionCard" Margin="0,18,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <TextBlock Text="Selection controls" Style="{StaticResource DemoLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox Content="Enable notifications" Style="{StaticResource ClaudeCheckBox}"
                                              IsChecked="True" AutomationProperties.AutomationId="ChkNotifications"/>
                                    <CheckBox Content="Weekly digest" Style="{StaticResource ClaudeCheckBox}"
                                              Margin="0,12,0,0" AutomationProperties.AutomationId="ChkDigest"/>
                                    <CheckBox Content="Unavailable option" Style="{StaticResource ClaudeCheckBox}"
                                              Margin="0,12,0,0" IsEnabled="False"
                                              AutomationProperties.AutomationId="ChkUnavailable"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <RadioButton Content="Starter" Style="{StaticResource ClaudeRadio}"
                                                 GroupName="plan" IsChecked="True"
                                                 AutomationProperties.AutomationId="RadStarter"/>
                                    <RadioButton Content="Pro" Style="{StaticResource ClaudeRadio}"
                                                 GroupName="plan" Margin="0,12,0,0"
                                                 AutomationProperties.AutomationId="RadPro"/>
                                    <CheckBox Content="Dark mode" Style="{StaticResource ClaudeSwitch}"
                                              IsChecked="True" Margin="0,12,0,0"
                                              AutomationProperties.AutomationId="SwDarkMode"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Cards -->
                <TextBlock Text="Cards" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Containers for related content, with an optional action row."/>
                <GroupBox AutomationProperties.AutomationId="DisplayCards" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DisplayCard}" Height="170.9">
                                <StackPanel>
                                    <TextBlock Text="Workspace settings" Style="{StaticResource DisplayCardTitle}"/>
                                    <TextBlock Text="Manage members, permissions and preferences for your team's shared space."
                                               Style="{StaticResource DisplayCardText}" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Content="Open settings" Style="{StaticResource SecondaryButtonSm}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DisplayCard}" Height="170.9">
                                <StackPanel>
                                    <TextBlock Text="Your plan" Style="{StaticResource DisplayCardTitle}"/>
                                    <TextBlock Text="You're on the Starter plan. Upgrade any time to unlock more projects and history."
                                               Style="{StaticResource DisplayCardText}" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Content="Upgrade plan" Style="{StaticResource PrimaryButtonSm}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- Badges -->
                <TextBlock Text="Badges" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Compact status labels. A dot marks state; use the plain variant when no dot is wanted."/>
                <GroupBox AutomationProperties.AutomationId="DisplayBadges" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="Draft" Style="{StaticResource BadgeNeutralDot}"/>
                            <ContentControl Content="In review" Style="{StaticResource BadgeBrandDot}" Margin="12,0,0,0"/>
                            <ContentControl Content="Active" Style="{StaticResource BadgeSuccessDot}" Margin="12,0,0,0"/>
                            <ContentControl Content="Pending" Style="{StaticResource BadgeWarningDot}" Margin="12,0,0,0"/>
                            <ContentControl Content="Overdue" Style="{StaticResource BadgeDangerDot}" Margin="12,0,0,0"/>
                            <ContentControl Content="v1.0" Tag="Plain" Style="{StaticResource BadgeNeutralDot}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Table -->
                <TextBlock Text="Data table" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Text="Aligned columns, tabular numbers, row hover and status badges. Scrolls sideways on narrow screens."
                           Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Border Style="{StaticResource DemoCard}" Margin="0,22,0,0">
                    <StackPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                    <Grid local:TableClip.Enabled="True">
                    <DataGrid x:Name="DemoGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                              Margin="0,0,0,-1" HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource Surface}" BorderThickness="0"
                              Foreground="{StaticResource Ink}" FontSize="14"
                              GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserSortColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource TableHeader}"
                              RowStyle="{StaticResource TableRowTall}"
                              CellStyle="{StaticResource TableCell}"
                              AutomationProperties.AutomationId="DemoGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Project" Width="231*" CellStyle="{StaticResource TableRowHeaderCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="Av" Width="30" Height="30" CornerRadius="99"
                                                    Background="{StaticResource BrandSoft}" BorderThickness="1"
                                                    BorderBrush="#FFECD4C8" Margin="0,0,10,0">
                                                <TextBlock x:Name="AvText" Text="{Binding Initials}"
                                                           FontFamily="{StaticResource Sans}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brand}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource Sans}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2}"
                                                           LineHeight="19.2" LineStackingStrategy="BlockLineHeight"/>
                                                <TextBlock Text="{Binding Team}" FontFamily="{StaticResource Sans}"
                                                           FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,2,0,0"
                                                           LineHeight="19.2" LineStackingStrategy="BlockLineHeight"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Owner}" Value="Jonas Silva">
                                                <Setter TargetName="Av" Property="Background" Value="{StaticResource Ink}"/>
                                                <Setter TargetName="Av" Property="BorderBrush" Value="{StaticResource Ink}"/>
                                                <Setter TargetName="AvText" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Owner}" Value="Mia Chen">
                                                <Setter TargetName="Av" Property="Background" Value="#FFE6EEE7"/>
                                                <Setter TargetName="Av" Property="BorderBrush" Value="#FFD3E3D6"/>
                                                <Setter TargetName="AvText" Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Owner" Width="160*" Binding="{Binding Owner}" ElementStyle="{StaticResource TableCellText}"/>
