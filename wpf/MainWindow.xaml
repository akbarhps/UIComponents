                                <ContentControl Style="{StaticResource CrumbSep}" Margin="8,3.9,8,0"/>
                                <Button Content="Website refresh" Style="{StaticResource CrumbLink}" Tag="Data table"
                                        Click="Crumb_Click" AutomationProperties.AutomationId="CrumbRefresh"/>
                                <ContentControl Style="{StaticResource CrumbSep}" Margin="8,3.9,8,0"/>
                                <TextBlock Text="Settings" Style="{StaticResource CrumbCurrent}"
                                           AutomationProperties.AutomationId="CrumbCurrent"
