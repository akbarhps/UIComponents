                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Border x:Name="Step2_Line" Height="2" Background="{StaticResource Line}"
                                            Margin="30,14,10,0" VerticalAlignment="Top"/>
                                    <Border x:Name="Step2_Marker" Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}"
                                            BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1">
