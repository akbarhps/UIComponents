                                <Grid Grid.Column="3">
                                    <Border x:Name="Step3_Marker" Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}"
                                            BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1">
                                        <Grid>
                                            <TextBlock x:Name="Step3_Num" Text="4" Style="{StaticResource StepMarkerText}"
                                                       Foreground="{StaticResource Ink3}" AutomationProperties.AutomationId="Step3_Num"
                                                        AutomationProperties.ItemStatus="todo"/>
                                            <GroupBox x:Name="Step3_Check" Visibility="Collapsed" AutomationProperties.AutomationId="Step3_Check">
                                                <GroupBox.Template>
                                                    <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                                </GroupBox.Template>
                                                <ContentControl Style="{StaticResource IconCheck}" Width="15" Height="15" Foreground="White"/>
                                            </GroupBox>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="0,39,16,0">
                                        <TextBlock x:Name="Step3_Title" Text="Done" Style="{StaticResource StepTitle}"
                                                   Foreground="{StaticResource Ink3}"/>
                                        <TextBlock Text="All set" Style="{StaticResource StepDesc}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel Orientation="Horizontal" Height="50">
                                <Button x:Name="StepPrev" Content="Previous" Style="{StaticResource SecondaryButtonSm}"
                                        VerticalAlignment="Center" IsEnabled="False" Click="StepPrev_Click"
                                        AutomationProperties.AutomationId="StepPrev"/>
                                <Button x:Name="StepNext" Content="Next step" Style="{StaticResource PrimaryButtonSm}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" Click="StepNext_Click"
                                        AutomationProperties.AutomationId="StepNext"/>
                                <TextBlock x:Name="StepStatus" Text="Step 1 of 4" Style="{StaticResource FieldHint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="StepStatus"/>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,8,0,26"/>
                            <TextBlock Text="Vertical" Style="{StaticResource DemoLabel}"/>
                            <StackPanel Height="186.7" AutomationProperties.AutomationId="VerticalStepper">
                                <Grid Height="69.6">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Brand}"
                                            BorderBrush="{StaticResource Brand}" BorderThickness="1" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Panel.ZIndex="1">
                                        <ContentControl Style="{StaticResource IconCheck}" Width="15" Height="15" Foreground="White"/>
                                    </Border>
                                    <Border Width="2" Height="47.6" Background="{StaticResource Brand}" Margin="14,30,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <StackPanel Margin="44,4,0,0">
                                        <TextBlock Text="Account created" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Your details are saved." Style="{StaticResource StepDesc}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="69.6">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource BrandSoft}"
                                            BorderBrush="{StaticResource Brand}" BorderThickness="1" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Panel.ZIndex="1">
                                        <TextBlock Text="2" Style="{StaticResource StepMarkerText}" Foreground="{StaticResource Brand}"/>
                                    </Border>
                                    <Border Width="2" Height="47.6" Background="{StaticResource Line}" Margin="14,30,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <StackPanel Margin="44,4,0,0">
                                        <TextBlock Text="Set up workspace" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Invite your team and pick a plan." Style="{StaticResource StepDesc}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="47.6">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1" HorizontalAlignment="Left"
                                            VerticalAlignment="Top" Panel.ZIndex="1">
                                        <TextBlock Text="3" Style="{StaticResource StepMarkerText}" Foreground="{StaticResource Ink3}"/>
                                    </Border>
                                    <StackPanel Margin="44,4,0,0">
                                        <TextBlock Text="Review and finish" Style="{StaticResource StepTitle}" Foreground="{StaticResource Ink3}"/>
                                        <TextBlock Text="Confirm everything looks right." Style="{StaticResource StepDesc}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Tooltips -->
                <TextBlock Text="Tooltips" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Hover or focus a control to reveal its label. Tooltips appear on all four sides."/>
                <GroupBox AutomationProperties.AutomationId="TipsCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel Orientation="Horizontal" Height="42">
                            <Button Content="Top" Style="{StaticResource SecondaryButton}"
                                    local:Popover.Text="Top tooltip" local:Popover.Side="Top"
                                    AutomationProperties.AutomationId="TipTop" AutomationProperties.HelpText="Top tooltip"/>
                            <Button Content="Bottom" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                    local:Popover.Text="Bottom tooltip" local:Popover.Side="Bottom"
                                    AutomationProperties.AutomationId="TipBottom" AutomationProperties.HelpText="Bottom tooltip"/>
                            <Button Content="Left" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                    local:Popover.Text="Left tooltip" local:Popover.Side="Left"
                                    AutomationProperties.AutomationId="TipLeft" AutomationProperties.HelpText="Left tooltip"/>
                            <Button Content="Right" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                    local:Popover.Text="Right tooltip" local:Popover.Side="Right"
                                    AutomationProperties.AutomationId="TipRight" AutomationProperties.HelpText="Right tooltip"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                    local:Popover.Text="Save your changes" local:Popover.Side="Top"
                                    AutomationProperties.AutomationId="TipSave" AutomationProperties.HelpText="Save your changes"/>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Empty state -->
                <TextBlock Text="Empty state" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="A full-size placeholder for when there's nothing to show yet. Give the person a clear next step."/>
                <GroupBox AutomationProperties.AutomationId="EmptyState" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource DisplayCard}" Height="281.8">
                                <StackPanel Margin="20,44,20,44">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="27">
                                        <ContentControl Style="{StaticResource IconCard}" Foreground="{StaticResource Brand}"
                                                        Width="22" Height="22" VerticalAlignment="Center"/>
                                        <TextBlock Width="9"/>
                                        <TextBlock Text="No projects yet" Style="{StaticResource EmptyTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="Projects you create will appear here. Start with a blank project to see how it works."
                                               Style="{StaticResource EmptyText}" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                        <Button Content="New project" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="EmptyAction"/>
                                        <Button Content="View guide" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                                AutomationProperties.AutomationId="EmptyGuide"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DisplayCard}" Height="281.8">
                                <StackPanel Margin="20,44,20,44">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="27">
                                        <ContentControl Style="{StaticResource IconSearch}" Foreground="{StaticResource Brand}"
                                                        Width="22" Height="22" VerticalAlignment="Center"/>
                                        <TextBlock Width="9"/>
                                        <TextBlock Text="No results found" Style="{StaticResource EmptyTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="We couldn't find anything for that search. Try a different term or clear your filters."
                                               Style="{StaticResource EmptyText}" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                        <Button Content="Clear filters" Style="{StaticResource SecondaryButton}" AutomationProperties.AutomationId="EmptyClear"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- Skeleton -->
                <TextBlock Text="Skeleton loader" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="Placeholders that hold the shape of content while it loads, so the layout doesn't jump when data arrives."/>
                <GroupBox AutomationProperties.AutomationId="Skeleton" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <Border x:Name="LoadingCue" Style="{StaticResource MotionCue}"
                                    AutomationProperties.AutomationId="LoadingCue">
                                <TextBlock Text="Loading content…" FontFamily="{StaticResource Sans}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brand}"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DisplayCard}" Height="162">
                                    <StackPanel>
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkCircle}"/>
                                            <Grid Grid.Column="2" Height="32" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="12"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55*"/>
                                                        <ColumnDefinition Width="45*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SkLine}"/>
                                                </Grid>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="35*"/>
                                                        <ColumnDefinition Width="65*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SkLine}"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,22,0,0">
                                            <Border Style="{StaticResource SkLine}"/>
                                        </Grid>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82*"/>
                                                <ColumnDefinition Width="18*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkLine}"/>
                                        </Grid>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64*"/>
                                                <ColumnDefinition Width="36*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DisplayCard}" Height="162">
                                    <StackPanel>
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkCircle}"/>
                                            <Grid Grid.Column="2" Height="32" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="12"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48*"/>
                                                        <ColumnDefinition Width="52*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SkLine}"/>
                                                </Grid>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30*"/>
                                                        <ColumnDefinition Width="70*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SkLine}"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,22,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90*"/>
                                                <ColumnDefinition Width="10*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkLine}"/>
                                        </Grid>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72*"/>
                                                <ColumnDefinition Width="28*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Table rows" Style="{StaticResource DemoLabel}" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource DisplayCard}" Height="156">
                                <StackPanel>
                                    <Border Height="37" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                        <!-- Star values are the web's % of the 876px row at the 984 reference;
                                             16px columns are the CSS gap, trailing star is the flex spacer. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="245.3*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="175.2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="122.6*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="197.3*"/>
                                                <ColumnDefinition Width="87.6*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="2" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="37" Padding="0,12,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="297.8*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="157.7*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="105.1*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="188.6*"/>
                                                <ColumnDefinition Width="78.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="2" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="36" Padding="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210.2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="192.7*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="131.4*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="197.3*"/>
                                                <ColumnDefinition Width="96.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="2" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="4" Style="{StaticResource SkLine}"/>
                                            <Border Grid.Column="7" Style="{StaticResource SkLine}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- Form inputs -->
                <local:InputControls x:Name="FormInputs"/>

                <!-- Pickers -->
                <local:PickerControls x:Name="Pickers"/>

                <!-- Data controls -->
                <local:DataControls x:Name="DataTables"/>

                <!-- Advanced controls -->
                <local:AdvancedControls x:Name="AdvancedTables"/>

                <!-- Toast demos -->
                <local:ToastControls x:Name="ToastDemos"/>

                <!-- Overlay demos -->
                <local:OverlayControls x:Name="Overlays"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
