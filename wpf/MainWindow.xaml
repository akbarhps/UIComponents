<Window x:Class="UIComponents.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UIComponents.Wpf"
        Title="Claude UI — WPF components" Height="820" Width="1180"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Sans}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="28,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,26">
                    <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource BrandBright}" Margin="0,0,11,0"/>
                    <StackPanel>
                        <TextBlock Text="Claude UI" FontFamily="{StaticResource Serif}" FontSize="18" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Component library" FontSize="11" Foreground="{StaticResource Ink3}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                    <TextBlock Text="Basics" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}" Margin="0,0,0,8"/>
                    <TextBlock Text="Buttons" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Cards" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Badges" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Forms" Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
                    <TextBlock Text="Fields" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                    <TextBlock Text="Data" Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink3}"/>
                    <TextBlock Text="Table" Margin="11,0,0,8" Foreground="{StaticResource Ink2}"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="48,56,48,96">
            <StackPanel x:Name="Sections" MaxWidth="1000">
                <!-- Masthead -->
                <Border Background="{StaticResource BrandSoft}" CornerRadius="99" Padding="11,5" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <TextBlock Text="Web components, version 1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brand}"/>
                </Border>
                <TextBlock Text="Interface components" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="{StaticResource Ink}" TextWrapping="Wrap" MaxWidth="640"/>
                <TextBlock Text="A native WPF component library with the same warm, editorial feel as the web version. Every colour and font comes from a shared token dictionary." Style="{StaticResource SectionDesc}" MaxWidth="640" Margin="0,12,0,0"/>

                <!-- Buttons -->
                <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Text="Primary, dark, secondary, ghost and danger variants." Style="{StaticResource SectionDesc}"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Primary action" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" AutomationProperties.AutomationId="BtnPrimary"/>
                            <Button Content="Dark" Style="{StaticResource DarkButton}" Margin="0,0,12,0"/>
                            <Button Content="Secondary" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                            <Button Content="Ghost" Style="{StaticResource GhostButton}" Margin="0,0,12,0"/>
                            <Button Content="Danger" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Forms -->
                <TextBlock Text="Forms" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Text="Labels, inputs, hints and selection controls." Style="{StaticResource SectionDesc}"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ClaudeInput}" Text="Ada Lovelace" AutomationProperties.AutomationId="FieldName"/>
                            <TextBlock Text="As it should appear on your account." Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ClaudeInput}" Text="you@example.com" AutomationProperties.AutomationId="FieldEmail"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cards & badges -->
                <TextBlock Text="Cards &amp; badges" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Workspace settings" FontFamily="{StaticResource Serif}" FontSize="17" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Manage members, permissions and preferences for your team." FontSize="14" Foreground="{StaticResource Ink2}" Margin="0,8,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BadgeSuccess}">
                                <TextBlock Text="Active" Style="{StaticResource BadgeText}" Foreground="{StaticResource Success}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeBrand}" Margin="10,0,0,0">
                                <TextBlock Text="In review" Style="{StaticResource BadgeText}" Foreground="{StaticResource Brand}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeNeutral}" Margin="10,0,0,0">
                                <TextBlock Text="Draft" Style="{StaticResource BadgeText}" Foreground="{StaticResource Ink2}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Table -->
                <TextBlock Text="Data table" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Text="Aligned columns, tabular numbers, row hover and status badges." Style="{StaticResource SectionDesc}"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <DataGrid x:Name="DemoGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                              Background="{StaticResource Surface}" BorderThickness="0"
                              Foreground="{StaticResource Ink}" FontSize="14"
                              GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserSortColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource TableHeader}"
                              RowStyle="{StaticResource TableRow}"
                              CellStyle="{StaticResource TableCell}"
                              AutomationProperties.AutomationId="DemoGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Project" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="Av" Width="30" Height="30" CornerRadius="99"
                                                    Background="{StaticResource BrandSoft}" Margin="0,0,10,0">
                                                <TextBlock x:Name="AvText" Text="{Binding Initials}"
                                                           FontFamily="{StaticResource Sans}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brand}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource Sans}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="{Binding Team}" FontFamily="{StaticResource Sans}"
                                                           FontSize="12" Foreground="{StaticResource Ink3}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Owner}" Value="Jonas Silva">
                                                <Setter TargetName="Av" Property="Background" Value="{StaticResource Ink}"/>
                                                <Setter TargetName="AvText" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Owner}" Value="Mia Chen">
                                                <Setter TargetName="Av" Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                <Setter TargetName="AvText" Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Owner}" Value="Sam Patel">
                                                <Setter TargetName="Av" Property="Background" Value="{StaticResource BgDeep}"/>
                                                <Setter TargetName="AvText" Property="Foreground" Value="{StaticResource Ink2}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Owner" Width="125" Binding="{Binding Owner}"/>
                            <DataGridTemplateColumn Header="Status" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" Style="{StaticResource BadgeSuccess}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                         Fill="{Binding ElementName=BadgeLabel, Path=Foreground}"/>
                                                <TextBlock x:Name="BadgeLabel" Text="{Binding Status}"
                                                           Style="{StaticResource BadgeText}" Foreground="{StaticResource Success}"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="In review">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource BrandSoft}"/>
                                                <Setter TargetName="BadgeLabel" Property="Foreground" Value="{StaticResource Brand}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSoft}"/>
                                                <Setter TargetName="BadgeLabel" Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource BgDeep}"/>
                                                <Setter TargetName="BadgeLabel" Property="Foreground" Value="{StaticResource Ink2}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Updated" Width="115" Binding="{Binding Updated}"/>
                            <DataGridTemplateColumn Header="Budget" Width="95" HeaderStyle="{StaticResource TableHeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Budget}" FontFamily="{StaticResource Sans}"
                                                   FontSize="14" Foreground="{StaticResource Ink}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open" Style="{StaticResource TableAction}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>

                    <Grid Margin="0,18,0,0" AutomationProperties.AutomationId="TablePagination">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show" FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8"
                                    Padding="9,0,8,0" Height="32" Margin="8,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="25" FontSize="13" Foreground="{StaticResource Ink}"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Path Data="M 1 3 L 5 7 L 9 3" Stroke="{StaticResource Ink3}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="8" Stretch="Uniform"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="per page" FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Previous" Style="{StaticResource SecondaryButton}" MinHeight="32"
                                    Padding="12,6" FontSize="13" IsEnabled="False" Margin="0,0,6,0"/>
                            <Button Content="1" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="12,6"
                                    FontSize="13" Width="34" Background="{StaticResource Ink}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,6,0"/>
                            <Button Content="Next" Style="{StaticResource SecondaryButton}" MinHeight="32"
                                    Padding="12,6" FontSize="13" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Showing 1–5 of 5" FontSize="13" Foreground="{StaticResource Ink3}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Alerts -->
                <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource InfoSoft}" CornerRadius="12" Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="i" FontSize="18" Foreground="{StaticResource Info}" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Good to know" FontWeight="SemiBold" Foreground="{StaticResource Info}"/>
                                    <TextBlock Text="Your changes save automatically as you type." FontSize="14" Foreground="{StaticResource Ink2}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SuccessSoft}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="18" Foreground="{StaticResource Success}" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Saved" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                    <TextBlock Text="Your settings have been updated." FontSize="14" Foreground="{StaticResource Ink2}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Selection controls -->
                <TextBlock Text="Selection controls" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <CheckBox Content="Enable notifications" Style="{StaticResource ClaudeCheckBox}" IsChecked="True" AutomationProperties.AutomationId="ChkNotifications"/>
                        <CheckBox Content="Weekly digest" Style="{StaticResource ClaudeCheckBox}" Margin="0,12,0,0" AutomationProperties.AutomationId="ChkDigest"/>
                        <ComboBox Width="240" HorizontalAlignment="Left" Margin="0,18,0,0" SelectedIndex="0" AutomationProperties.AutomationId="CmbRole">
                            <ComboBoxItem Content="Designer"/>
                            <ComboBoxItem Content="Engineer"/>
                            <ComboBoxItem Content="Product manager"/>
                        </ComboBox>
                        <DatePicker Width="200" HorizontalAlignment="Left" Margin="0,18,0,0" AutomationProperties.AutomationId="DatePick"/>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <TextBlock Text="Progress &amp; tabs" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <ProgressBar Height="8" Value="64" Maximum="100" AutomationProperties.AutomationId="ProgressBar"/>
                        <Slider Width="300" HorizontalAlignment="Left" Value="40" Margin="0,20,0,0" AutomationProperties.AutomationId="Slider"/>
                        <TabControl Margin="0,20,0,0" Height="140" AutomationProperties.AutomationId="Tabs">
                            <TabItem Header="Profile">
                                <TextBlock Text="Update your name, photo and public profile details." Margin="12" Foreground="{StaticResource Ink2}"/>
                            </TabItem>
                            <TabItem Header="Security">
                                <TextBlock Text="Manage your password and two-factor authentication." Margin="12" Foreground="{StaticResource Ink2}"/>
                            </TabItem>
                            <TabItem Header="Billing">
                                <TextBlock Text="View invoices and update your payment method." Margin="12" Foreground="{StaticResource Ink2}"/>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- Accordion / list -->
                <TextBlock Text="Accordion &amp; list" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <Expander Header="Project overview" IsExpanded="True" AutomationProperties.AutomationId="Expander">
                            <TextBlock Text="Track scope, timeline and ownership in one place." Margin="12,6" Foreground="{StaticResource Ink2}"/>
                        </Expander>
                        <Expander Header="Team members" Margin="0,10,0,0">
                            <TextBlock Text="Invite people and manage their access." Margin="12,6" Foreground="{StaticResource Ink2}"/>
                        </Expander>
                        <ListBox Width="300" HorizontalAlignment="Left" Margin="0,18,0,0" SelectionMode="Multiple" AutomationProperties.AutomationId="MultiList">
                            <ListBoxItem Content="React" IsSelected="True"/>
                            <ListBoxItem Content="TypeScript"/>
                            <ListBoxItem Content="Design systems" IsSelected="True"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Avatars -->
                <TextBlock Text="Avatars" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Avatar}"><TextBlock Text="AL" Style="{StaticResource AvatarText}"/></Border>
                        <Border Style="{StaticResource Avatar}" Background="{StaticResource Ink}" Margin="10,0,0,0"><TextBlock Text="JS" Style="{StaticResource AvatarText}" Foreground="White"/></Border>
                        <Border Style="{StaticResource Avatar}" Background="#FFE6EEE7" Margin="10,0,0,0"><TextBlock Text="MK" Style="{StaticResource AvatarText}" Foreground="{StaticResource Success}"/></Border>
                    </StackPanel>
                </Border>

                <!-- Breadcrumbs -->
                <TextBlock Text="Breadcrumbs" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" AutomationProperties.AutomationId="Breadcrumbs">
                        <TextBlock Text="Workspace" Style="{StaticResource CrumbLink}"/>
                        <TextBlock Text="›" Style="{StaticResource CrumbSep}"/>
                        <TextBlock Text="Projects" Style="{StaticResource CrumbLink}"/>
                        <TextBlock Text="›" Style="{StaticResource CrumbSep}"/>
                        <TextBlock Text="Website refresh" Style="{StaticResource CrumbCurrent}"/>
                    </StackPanel>
                </Border>

                <!-- Stepper -->
                <TextBlock Text="Stepper" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <Grid AutomationProperties.AutomationId="Stepper">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="4" Height="2" Background="{StaticResource LineStrong}" VerticalAlignment="Top" Margin="18,14"/>
                        <StackPanel Grid.Column="0"><Ellipse Width="30" Height="30" Fill="{StaticResource Brand}" HorizontalAlignment="Center"/><TextBlock Text="1 Account" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                        <StackPanel Grid.Column="1"><Ellipse Width="30" Height="30" Fill="{StaticResource BrandSoft}" Stroke="{StaticResource Brand}" StrokeThickness="1" HorizontalAlignment="Center"/><TextBlock Text="2 Workspace" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                        <StackPanel Grid.Column="2"><Ellipse Width="30" Height="30" Fill="{StaticResource Surface}" Stroke="{StaticResource LineStrong}" StrokeThickness="1" HorizontalAlignment="Center"/><TextBlock Text="3 Review" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                        <StackPanel Grid.Column="3"><Ellipse Width="30" Height="30" Fill="{StaticResource Surface}" Stroke="{StaticResource LineStrong}" StrokeThickness="1" HorizontalAlignment="Center"/><TextBlock Text="4 Done" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"/></StackPanel>
                    </Grid>
                </Border>

                <!-- Tooltips & action menu -->
                <TextBlock Text="Tooltips &amp; action menu" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Hover me" Style="{StaticResource SecondaryButton}" ToolTip="Helpful text" AutomationProperties.AutomationId="BtnTooltip"/>
                        <Button Content="More actions" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" AutomationProperties.AutomationId="BtnMenu">
                            <Button.ContextMenu>
                                <ContextMenu AutomationProperties.AutomationId="ActionMenu">
                                    <MenuItem Header="Edit project"/>
                                    <MenuItem Header="Duplicate"/>
                                    <MenuItem Header="Delete project"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <TextBlock Text="Empty state" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" AutomationProperties.AutomationId="EmptyState">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Style="{StaticResource EmptyIcon}"><TextBlock Text="▢" FontSize="18" Foreground="{StaticResource Brand}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="No projects yet" FontFamily="{StaticResource Serif}" FontSize="20" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Projects you create will appear here. Start with a blank project." FontSize="14" Foreground="{StaticResource Ink2}" Margin="0,10,0,0"/>
                        <Button Content="New project" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" AutomationProperties.AutomationId="EmptyAction"/>
                    </StackPanel>
                </Border>

                <!-- Skeleton -->
                <TextBlock Text="Skeleton loader" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel AutomationProperties.AutomationId="Skeleton">
                        <Border Height="14" Width="300" CornerRadius="6" Background="{StaticResource ShimmerBrush}" HorizontalAlignment="Left"/>
                        <Border Height="14" Width="220" CornerRadius="6" Background="{StaticResource ShimmerBrush}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <Border Height="14" Width="260" CornerRadius="6" Background="{StaticResource ShimmerBrush}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Form inputs -->
                <local:InputControls/>

                <!-- Data controls -->
                <local:DataControls/>

                <!-- Advanced controls -->
                <local:AdvancedControls/>

                <!-- Overlay -->
                <TextBlock Text="Overlays" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <Button Content="Open dialog" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Click="OpenDialog_Click" AutomationProperties.AutomationId="BtnOpenDialog"/>
                        <TextBlock x:Name="DialogResultText" Text="No dialog opened yet." Margin="0,14,0,0"
                                   Foreground="{StaticResource Ink2}" AutomationProperties.AutomationId="DialogResult"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
