                                <RowDefinition Height="*"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Alert}" Background="{StaticResource InfoSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconInfo}" Foreground="{StaticResource Info}"
                                                    Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Good to know" Style="{StaticResource AlertTitle}" Foreground="{StaticResource Info}"/>
                                        <TextBlock Text="Your changes save automatically as you type." Style="{StaticResource AlertText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Alert}" Background="{StaticResource SuccessSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconCheck}" Foreground="{StaticResource Success}"
                                                    Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Saved" Style="{StaticResource AlertTitle}" Foreground="{StaticResource Success}"/>
                                        <TextBlock Text="Your settings have been updated." Style="{StaticResource AlertText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Alert}" Background="{StaticResource WarningSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconAlert}" Foreground="{StaticResource Warning}"
                                                    Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Check your input" Style="{StaticResource AlertTitle}" Foreground="{StaticResource Warning}"/>
                                        <TextBlock Text="Some fields still need your attention." Style="{StaticResource AlertText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Alert}" Background="{StaticResource DangerSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconClose}" Foreground="{StaticResource Danger}"
                                                    Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Something went wrong" Style="{StaticResource AlertTitle}" Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="We couldn't complete that request. Try again." Style="{StaticResource AlertText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- Progress -->
                <TextBlock Text="Progress bar" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
                <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                           Text="A determinate bar for work with a known duration, such as an upload. The demo animates through a simulated upload."/>
                <GroupBox AutomationProperties.AutomationId="DisplayProgress" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </GroupBox.Template>
                    <Border Style="{StaticResource DemoCard}">
                        <StackPanel>
                            <Grid Height="20.8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProgressLabel" Text="Uploading files…" FontFamily="{StaticResource Sans}" FontSize="13"
                                           Foreground="{StaticResource Ink2}" LineHeight="20.8"
                                           LineStackingStrategy="MaxHeight" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="ProgressLabel"/>
                                <TextBlock x:Name="ProgressValue" Grid.Column="1" Text="0%" FontFamily="{StaticResource Sans}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource Ink}" LineHeight="20.8"
                                           LineStackingStrategy="MaxHeight" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"
                                           AutomationProperties.AutomationId="ProgressValue"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressBar" Style="{StaticResource DisplayProgress}" Margin="0,8,0,0"
                                         AutomationProperties.AutomationId="ProgressBar"/>
                            <Border Style="{StaticResource Divider}"/>
