                           Text="Progress through a multi-step flow. Completed steps show a check, the current step is highlighted, and the controls below move between them."/>
                <GroupBox AutomationProperties.AutomationId="StepperCard" Margin="0,22,0,0">
                    <GroupBox.Template>
                        <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                    </GroupBox.Template>
