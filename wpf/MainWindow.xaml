                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Review your current plan, payment method and past invoices."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="One at a time" Style="{StaticResource DemoLabel}"/>
                                <Border Style="{StaticResource Accordion}" Width="450">
                                    <StackPanel Width="440">
                                        <ToggleButton x:Name="AccSingle_0" Content="Account" Style="{StaticResource AccordionTrigger}"
                                                      IsChecked="True" Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccSingle_0" AutomationProperties.Name="Account"/>
                                        <GroupBox x:Name="AccSingle_Panel0" Height="40.4"
                                                    AutomationProperties.AutomationId="AccSingle_Panel0">
                                            <GroupBox.Template>
                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Update your name, email and profile photo."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                        <Border Height="1" Background="{StaticResource Line}"/>
                                        <ToggleButton x:Name="AccSingle_1" Content="Notifications" Style="{StaticResource AccordionTrigger}"
                                                      Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccSingle_1" AutomationProperties.Name="Notifications"/>
                                        <GroupBox x:Name="AccSingle_Panel1" Height="40.4" Visibility="Collapsed"
                                                    AutomationProperties.AutomationId="AccSingle_Panel1">
                                            <GroupBox.Template>
                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Choose which updates you receive and how."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                        <Border Height="1" Background="{StaticResource Line}"/>
                                        <ToggleButton x:Name="AccSingle_2" Content="Privacy" Style="{StaticResource AccordionTrigger}"
                                                      Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccSingle_2" AutomationProperties.Name="Privacy"/>
                                        <GroupBox x:Name="AccSingle_Panel2" Height="40.4" Visibility="Collapsed"
                                                    AutomationProperties.AutomationId="AccSingle_Panel2">
                                            <GroupBox.Template>
                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Control who can see your activity and data."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- Avatars -->
