                                    <StackPanel Width="440">
                                        <ToggleButton x:Name="AccMulti_0" Content="Project overview" Style="{StaticResource AccordionTrigger}"
                                                      IsChecked="True" Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccMulti_0" AutomationProperties.Name="Project overview"/>
                                        <GroupBox x:Name="AccMulti_Panel0" Height="40.4" AutomationProperties.AutomationId="AccMulti_Panel0">
                                            <GroupBox.Template>
                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Track scope, timeline and ownership for this project in one place."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                        <Border Height="1" Background="{StaticResource Line}"/>
                                        <ToggleButton x:Name="AccMulti_1" Content="Team members" Style="{StaticResource AccordionTrigger}"
                                                      Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccMulti_1" AutomationProperties.Name="Team members"/>
                                        <GroupBox x:Name="AccMulti_Panel1" Height="62.8" Visibility="Collapsed"
                                                    AutomationProperties.AutomationId="AccMulti_Panel1">
                                            <GroupBox.Template>
                                                <ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate>
                                            </GroupBox.Template>
                                            <TextBlock Text="Invite people, assign roles and manage their access to the workspace."
                                                       Style="{StaticResource AccordionPanelText}" Margin="18,0,18,0"/>
                                        </GroupBox>
                                        <Border Height="1" Background="{StaticResource Line}"/>
                                        <ToggleButton x:Name="AccMulti_2" Content="Billing and plan" Style="{StaticResource AccordionTrigger}"
                                                      Checked="Accordion_Changed" Unchecked="Accordion_Changed"
                                                      AutomationProperties.AutomationId="AccMulti_2" AutomationProperties.Name="Billing and plan"/>
                                        <GroupBox x:Name="AccMulti_Panel2" Height="40.4" Visibility="Collapsed"
                                                    AutomationProperties.AutomationId="AccMulti_Panel2">
