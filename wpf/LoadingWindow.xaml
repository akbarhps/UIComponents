<Window x:Class="UIComponents.Wpf.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading" Width="380" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
    <StackPanel Margin="26" VerticalAlignment="Center">
        <ProgressBar Height="6" IsIndeterminate="True" AutomationProperties.AutomationId="LoadingBar"/>
        <TextBlock Text="Preparing your workspace" FontFamily="{StaticResource Serif}" FontSize="18"
                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock Text="Please wait a moment while we set things up." FontSize="13"
                   Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
