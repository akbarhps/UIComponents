<UserControl x:Class="UIComponents.Wpf.PickerControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:UIComponents.Wpf">
    <StackPanel x:Name="SectionList">
        <TextBlock Text="File input" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
            <StackPanel>
                <Button Content="Browse files…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Click="Browse_Click" AutomationProperties.AutomationId="BtnBrowse"/>
                <ListBox x:Name="FileList" Height="100" Margin="0,12,0,0" AutomationProperties.AutomationId="FileList"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Date picker" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="One component, three granularities. Pick a full date, a month and year, or just a year."/>
        <GroupBox AutomationProperties.AutomationId="DatePickerCard" Margin="0,22,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </GroupBox.Template>
            <Border Style="{StaticResource DemoCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="73.8"/>
                        <RowDefinition Height="95.8"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Full date" Style="{StaticResource FieldLabel}"/>
                        <local:CalendarPicker AutomationProperties.AutomationId="PickDate"
                                              Label="Full date" Placeholder="Pick a date…"
                                              Mode="date" Icon="Calendar"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Month and year" Style="{StaticResource FieldLabel}"/>
                        <local:CalendarPicker AutomationProperties.AutomationId="PickMonth"
                                              Label="Month and year" Placeholder="Pick a month…"
                                              Mode="month" Icon="Calendar"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Year only" Style="{StaticResource FieldLabel}"/>
                        <local:CalendarPicker AutomationProperties.AutomationId="PickYear"
                                              Label="Year only" Placeholder="Pick a year…"
                                              Mode="year" Icon="Calendar"/>
                    </StackPanel>
                </Grid>
            </Border>
        </GroupBox>
    </StackPanel>
</UserControl>
