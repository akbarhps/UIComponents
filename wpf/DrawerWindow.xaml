<Window x:Class="UIComponents.Wpf.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit member" Width="420" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
    <Border Padding="26">
        <StackPanel>
            <TextBlock Text="Edit member" FontFamily="{StaticResource Serif}" FontSize="20" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" Margin="0,22,0,0"/>
            <TextBox Style="{StaticResource ClaudeInput}" Text="Jamie Rivera" AutomationProperties.AutomationId="DrawerName"/>
            <TextBlock Text="Role" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
            <ComboBox SelectedIndex="0" AutomationProperties.AutomationId="DrawerRole">
                <ComboBoxItem Content="Member"/>
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Viewer"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button Content="Delete" Style="{StaticResource DangerButton}" Width="80" Margin="0,0,10,0" AutomationProperties.AutomationId="DrawerDelete"/>
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,10,0" Click="Cancel_Click" AutomationProperties.AutomationId="DrawerCancel"/>
                <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Width="120" Click="Save_Click" AutomationProperties.AutomationId="DrawerSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
