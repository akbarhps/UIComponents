<UserControl x:Class="UIComponents.Wpf.DataControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UIComponents.Wpf">
    <StackPanel x:Name="SectionList">
        <!-- Grid input -->
        <TextBlock Text="Grid input" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="A table you can type into. Paste a block of Excel cells at once, select a row or column to edit every cell together, and clear a whole selection in one action."/>
        <Border Style="{StaticResource DemoCard}" Margin="0,22,0,0">
            <local:SheetGrid x:Name="InputGrid" AutomationProperties.AutomationId="InputGrid"/>
        </Border>

        <!-- Typed grid -->
        <TextBlock Text="Typed grid input" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="The same grid with typed columns: plain text, a dropdown select, and a checkbox. Selection, bulk editing, paste and clearing all work across them."/>
        <Border Style="{StaticResource DemoCard}" Margin="0,22,0,0">
            <local:SheetGrid x:Name="TypedGrid" AutomationProperties.AutomationId="TypedGrid"/>
        </Border>

        <!-- Filter table -->
        <TextBlock Text="Table with filters" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Text="Search by name and narrow by status. The count and empty state update as you type."
                   Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Border Style="{StaticResource DemoCard}" Margin="0,22,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="320" Height="45" VerticalAlignment="Center">
                        <TextBox x:Name="FilterSearch" Style="{StaticResource FieldInputSearch}" Tag="Search projects…"
                                 TextChanged="FilterSearch_TextChanged" AutomationProperties.AutomationId="FilterSearch"/>
                        <ContentControl Style="{StaticResource SearchIcon}" Margin="13,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Column="1" Background="{StaticResource BgDeep}" CornerRadius="9" Padding="3"
                            VerticalAlignment="Center" Margin="12,0,0,0" Height="37">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SegAll" Content="All" Tag="all" GroupName="FilterStatus"
                                         Style="{StaticResource SegmentButton}" Width="39.5" Height="31"
                                         Checked="FilterSegment_Checked" AutomationProperties.AutomationId="SegAll"/>
                            <RadioButton Content="Active" Tag="active" GroupName="FilterStatus"
                                         Style="{StaticResource SegmentButton}" Width="60.3" Height="31"
                                         Margin="2,0,0,0" Checked="FilterSegment_Checked"/>
                            <RadioButton Content="Pending" Tag="pending" GroupName="FilterStatus"
                                         Style="{StaticResource SegmentButton}" Width="72.3" Height="31"
                                         Margin="2,0,0,0" Checked="FilterSegment_Checked"/>
                            <RadioButton Content="Archived" Tag="archived" GroupName="FilterStatus"
                                         Style="{StaticResource SegmentButton}" Width="75.7" Height="31"
                                         Margin="2,0,0,0" Checked="FilterSegment_Checked"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FilterCount" Grid.Column="2" Text="6 of 6 projects" FontSize="13"
                               Foreground="{StaticResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="FilterCount"/>
                </Grid>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                    <Grid local:TableClip.Enabled="True">
                    <StackPanel>
                    <DataGrid x:Name="FilterGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Disabled" GridLinesVisibility="None" CanUserSortColumns="False" IsReadOnly="True"
                              Background="{StaticResource Surface}" BorderThickness="0" Foreground="{StaticResource Ink}"
                              ColumnHeaderStyle="{StaticResource TableHeader}" RowStyle="{StaticResource TableRow}"
                              CellStyle="{StaticResource TableCell}"
                              AutomationProperties.AutomationId="FilterGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Project" Width="361*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="{Binding Team}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Owner" Width="190*" Binding="{Binding Owner}" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTemplateColumn Header="Status" Width="187*" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            <DataGridTextColumn Header="Updated" Width="182*" Binding="{Binding Updated}" ElementStyle="{StaticResource TableCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="FilterEmpty" Visibility="Collapsed" Padding="36,57">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No matching projects" FontSize="15" FontWeight="Bold"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                       Margin="0,0,0,5" AutomationProperties.AutomationId="FilterEmpty"/>
                            <TextBlock Text="Try a different search or status." FontSize="14"
                                       Foreground="{StaticResource Ink2}" HorizontalAlignment="Center"
                                       LineHeight="22.4" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </Grid>
                </Border>
                <local:TablePagination x:Name="FilterPagination" PagerId="FilterPageSize" InfoText="Showing 1–6 of 6" AutomationProperties.AutomationId="FilterPagination"/>
            </StackPanel>
        </Border>

        <!-- Selection table -->
        <TextBlock Text="Table with row selection" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Text="Select rows with the header checkbox or individual boxes. A bulk-action bar appears with the count of selected rows."
                   Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Border Style="{StaticResource DemoCard}" Margin="0,22,0,0">
            <StackPanel>
                <Border x:Name="BulkBar" Visibility="Collapsed" Background="{StaticResource BrandSoft}"
                        BorderBrush="#FFECD4C8" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        AutomationProperties.AutomationId="BulkBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BulkText" Text="1 row selected" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="BulkText"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Export" Style="{StaticResource SecondaryButtonSm}" Margin="0,0,8,0"
                                    Click="BulkExport_Click" AutomationProperties.AutomationId="BulkExport"/>
                            <Button Content="Delete" Style="{StaticResource DangerButtonSm}"
                                    Click="BulkDelete_Click" AutomationProperties.AutomationId="BulkDelete"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                    <Grid local:TableClip.Enabled="True">
                    <DataGrid x:Name="SelectionGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              Margin="0,0,0,-1" HorizontalScrollBarVisibility="Disabled" GridLinesVisibility="None" CanUserSortColumns="False" IsReadOnly="True"
                              Background="{StaticResource Surface}" BorderThickness="0" Foreground="{StaticResource Ink}"
                              ColumnHeaderStyle="{StaticResource TableHeader}" RowStyle="{StaticResource TableRow}"
                              CellStyle="{StaticResource TableCell}"
                              AutomationProperties.AutomationId="SelectionGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox Style="{StaticResource ClaudeCheckBox}" Height="22.4"
                                              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"
                                              AutomationProperties.AutomationId="SelectAll"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ClaudeCheckBox}" Height="22.4"
                                                  IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  Checked="RowCheck_Changed" Unchecked="RowCheck_Changed"
                                                  AutomationProperties.AutomationId="RowCheck"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Project" Width="212*" Binding="{Binding Project}" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTextColumn Header="Owner" Width="178*" Binding="{Binding Owner}" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTemplateColumn Header="Status" Width="170*" CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                            <DataGridTextColumn Header="Updated" Width="155*" Binding="{Binding Updated}" ElementStyle="{StaticResource TableCellText}"/>
                            <DataGridTemplateColumn Header="Budget" Width="126*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Budget}" FontFamily="{StaticResource Sans}" FontSize="14"
                                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
