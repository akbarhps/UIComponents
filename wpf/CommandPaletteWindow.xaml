<Window x:Class="UIComponents.Wpf.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command palette" Width="520" Height="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
    <Border Padding="16">
        <StackPanel>
            <TextBox x:Name="Search" Style="{StaticResource ClaudeInput}" KeyDown="Search_KeyDown"
                     AutomationProperties.AutomationId="CmdSearch" ToolTip="Search for an action…"/>
            <ListBox x:Name="Commands" Margin="0,12,0,0" Height="280" SelectionChanged="Commands_SelectionChanged"
                     AutomationProperties.AutomationId="CmdList">
                <ListBoxItem Content="Create a project" AutomationProperties.AutomationId="CmdCreate"/>
                <ListBoxItem Content="Invite a member"/>
                <ListBoxItem Content="Export workspace"/>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
