<UserControl x:Class="UIComponents.Wpf.InputControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:UIComponents.Wpf">
    <StackPanel x:Name="SectionList">
        <TextBlock Text="Tag input" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="46">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TagList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrandSoft}" CornerRadius="6" Padding="7,4" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource Brand}" FontSize="12" FontWeight="SemiBold"/>
                                            <Button Content="×" Style="{StaticResource GhostButton}" FontSize="12" Padding="4,0" Margin="4,0,0,0"
                                                    Click="RemoveTag_Click" AutomationProperties.AutomationId="TagRemove"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="TagInput" Style="{StaticResource ClaudeInput}" BorderThickness="0" Width="140"
                                 KeyDown="TagInput_KeyDown" AutomationProperties.AutomationId="TagInput"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TagCount" Text="0 tags" Style="{StaticResource FieldHint}" AutomationProperties.AutomationId="TagCount"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Autocomplete" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <Border Style="{StaticResource ClaudeCard}" Margin="0,16,0,0">
            <StackPanel>
                <TextBox x:Name="AutoInput" Style="{StaticResource ClaudeInput}" Width="320" HorizontalAlignment="Left"
                         TextChanged="AutoInput_TextChanged" AutomationProperties.AutomationId="AutoInput"/>
                <Popup x:Name="AutoPopup" PlacementTarget="{Binding ElementName=AutoInput}" Placement="Bottom" Width="320">
                    <ListBox x:Name="AutoList" MaxHeight="200" Background="{StaticResource Surface}"
                             BorderBrush="{StaticResource Line}" SelectionChanged="AutoList_SelectionChanged"
                             AutomationProperties.AutomationId="AutoList"/>
                </Popup>
            </StackPanel>
        </Border>

        <TextBlock Text="Searchable select" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="A dropdown that filters its options as you type. Open it, search, then choose with a click or the arrow keys and Enter."/>
        <GroupBox AutomationProperties.AutomationId="ComboCard" Margin="0,22,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </GroupBox.Template>
            <Border Style="{StaticResource DemoCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Assignee" Style="{StaticResource FieldLabel}"/>
                        <local:SearchableSelect AutomationProperties.AutomationId="ComboAssignee"
                                                Label="Assignee" Placeholder="Select a person…"
                                                SearchPlaceholder="Search people…" SearchName="Search people"
                                                Options="Ada Lovelace|Design,Jonas Silva|Engineering,Mia Chen|Design,Sam Patel|Operations,Alex Rivera|Marketing,Priya Shah|Content"/>
                        <TextBlock Text="Type a name to narrow the list." Style="{StaticResource FieldHint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                        <local:SearchableSelect AutomationProperties.AutomationId="ComboProject"
                                                Label="Project" Placeholder="Select a project…"
                                                SearchPlaceholder="Search projects…" SearchName="Search projects"
                                                Options="Website refresh|Design,Mobile app|Engineering,Brand guidelines|Design,Help center|Content,Q3 campaign|Marketing,Legacy archive|Operations"/>
                        <TextBlock Text="Arrow keys and Enter work too." Style="{StaticResource FieldHint}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </GroupBox>

        <TextBlock Text="Multi-select with filter" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="Keep several values at once. Selections appear as removable chips, and the search narrows the options."/>
        <GroupBox AutomationProperties.AutomationId="MultiCard" Margin="0,22,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </GroupBox.Template>
            <Border Style="{StaticResource DemoCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Skills" Style="{StaticResource FieldLabel}"/>
                        <local:MultiSelect AutomationProperties.AutomationId="MultiSkills"
                                           Label="Skills" Placeholder="Select skills…"
                                           SearchPlaceholder="Search skills…" SearchName="Search skills"
                                           Options="React|Frontend,TypeScript|Frontend,Design systems|Design,Accessibility|Design,Testing|Engineering,Documentation|Content"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}"/>
                        <local:MultiSelect AutomationProperties.AutomationId="MultiTags"
                                           Label="Tags" Placeholder="Select tags…"
                                           SearchPlaceholder="Search tags…" SearchName="Search tags"
                                           Options="Urgent|Priority,Follow-up|Workflow,Blocked|Status,Research|Phase"/>
                    </StackPanel>
                </Grid>
            </Border>
        </GroupBox>
    </StackPanel>
</UserControl>
