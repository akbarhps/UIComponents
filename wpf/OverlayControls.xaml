<UserControl x:Class="UIComponents.Wpf.OverlayControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="SectionList" MaxWidth="984">
        <TextBlock Text="Modal dialog" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="Focused confirmation that interrupts the task. Opens from this button; closes via the button, the backdrop, or Escape."/>

        <GroupBox AutomationProperties.AutomationId="ModalCard" Margin="0,22,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </GroupBox.Template>
            <Border Style="{StaticResource DemoCard}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open dialog" Style="{StaticResource PrimaryButton}" Width="114.3"
                            Click="OpenModal_Click" AutomationProperties.AutomationId="OpenModal"/>
                </StackPanel>
            </Border>
        </GroupBox>

        <TextBlock Text="Loading modal" Style="{StaticResource SectionTitle}" Margin="0,46,0,0"/>
        <TextBlock Style="{StaticResource SheetSectionDesc}" Margin="0,8,0,0"
                   Text="Blocks every action while work is in progress. It can't be dismissed by clicking the backdrop or pressing Escape — the task closes it when it finishes."/>

        <GroupBox AutomationProperties.AutomationId="LoadingCard" Margin="0,22,0,0">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter/>
                </ControlTemplate>
            </GroupBox.Template>
            <Border Style="{StaticResource DemoCard}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Start loading" Style="{StaticResource PrimaryButton}" Width="117.9"
                            Click="OpenLoading_Click" AutomationProperties.AutomationId="OpenLoading"/>
                </StackPanel>
            </Border>
        </GroupBox>

        <!-- Moved into OverlayLayer by OverlayHost.Install; only app-level StaticResources here. -->
        <Grid x:Name="DialogStore" Visibility="Collapsed">
            <GroupBox x:Name="ModalDialog" Visibility="Collapsed" Focusable="True"
                      KeyboardNavigation.TabNavigation="None"
                      AutomationProperties.AutomationId="ModalDialog"
                      AutomationProperties.Name="Delete this project?">
                <GroupBox.Template>
                    <ControlTemplate TargetType="GroupBox">
                        <ContentPresenter/>
                    </ControlTemplate>
                </GroupBox.Template>
                <Grid Width="460" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModalCardShadow}"/>
                    <Border Style="{StaticResource ModalCard}">
                        <StackPanel>
                            <Grid Height="32">
                                <TextBlock Text="Delete this project?" Style="{StaticResource ModalTitle}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Button x:Name="ModalClose" Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ModalClose"
                                        AutomationProperties.Name="Close dialog"
                                        Click="ModalClose_Click">
                                    <ContentControl Style="{StaticResource IconClose}" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource ModalBody}" Height="44.8" Margin="0,10,0,0"
                                       Text="This will permanently remove the project and all of its contents. This action can't be undone."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                <Button x:Name="ModalCancel" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                        Width="77.9" AutomationProperties.AutomationId="ModalCancel"
                                        Click="ModalCancel_Click"/>
                                <Button x:Name="ModalConfirm" Content="Delete project" Style="{StaticResource DangerButton}"
                                        Width="125.4" Margin="10,0,0,0"
                                        AutomationProperties.AutomationId="ModalConfirm"
                                        Click="ModalConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="LoadingDialog" Visibility="Collapsed" Focusable="True"
                      AutomationProperties.AutomationId="LoadingDialog"
                      AutomationProperties.Name="Preparing your workspace"
                      AutomationProperties.ItemStatus="busy">
                <GroupBox.Template>
                    <ControlTemplate TargetType="GroupBox">
                        <ContentPresenter/>
                    </ControlTemplate>
                </GroupBox.Template>
                <Grid Width="380" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModalCardShadow}"/>
                    <Border Style="{StaticResource ModalCard}">
                        <StackPanel>
                            <Grid x:Name="LoadingSpinner" Width="36" Height="36" Margin="0,0,0,18"
                                  HorizontalAlignment="Center">
                                <Ellipse Width="36" Height="36" Stroke="{StaticResource BrandSoft}" StrokeThickness="3"/>
                                <Path Stroke="{StaticResource Brand}" StrokeThickness="3"
                                      Data="M6.33,6.33 A16.5,16.5 0 0,1 29.67,6.33">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="18" CenterY="18"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock Text="Preparing your workspace" Style="{StaticResource ModalTitle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Please wait a moment while we set things up for you."
                                       Style="{StaticResource ModalBody}" Height="44.8" Margin="0,9,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Border x:Name="LoadingBar" Height="4" Margin="0,22,0,0"
                                    Background="{StaticResource BgDeep}" CornerRadius="2">
                                <Border Width="114.094" Height="4" CornerRadius="2"
                                        Background="{StaticResource Brand}" HorizontalAlignment="Left">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="LoadingBarShift" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>
    </StackPanel>
</UserControl>
