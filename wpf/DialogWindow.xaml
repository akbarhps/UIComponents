<Window x:Class="UIComponents.Wpf.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="420" Height="230" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
    <Border Padding="26">
        <StackPanel>
            <TextBlock Text="Delete this project?" FontFamily="{StaticResource Serif}" FontSize="21" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="This will permanently remove the project and all of its contents."
                       FontSize="14" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0"
                        Click="Cancel_Click" AutomationProperties.AutomationId="DlgCancel"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}" Width="100"
                        Click="Delete_Click" AutomationProperties.AutomationId="DlgDelete"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
