<UserControl x:Class="UIComponents.Wpf.TablePagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Show" FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8"
                    Padding="9,0,8,0" Height="32" Margin="8,0" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="25" FontSize="13" Foreground="{StaticResource Ink}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Path Data="M 1 3 L 5 7 L 9 3" Stroke="{StaticResource Ink3}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="8" Stretch="Uniform"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock Text="per page" FontSize="13" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Previous" Style="{StaticResource SecondaryButton}" MinHeight="32"
                    Padding="12,6" FontSize="13" IsEnabled="False" Margin="0,0,6,0"/>
            <Button Content="1" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="12,6"
                    FontSize="13" Width="34" Background="{StaticResource Ink}" Foreground="White"
                    BorderThickness="0" Margin="0,0,6,0"/>
            <Button Content="Next" Style="{StaticResource SecondaryButton}" MinHeight="32"
                    Padding="12,6" FontSize="13" IsEnabled="False"/>
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding InfoText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="13" Foreground="{StaticResource Ink3}"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
